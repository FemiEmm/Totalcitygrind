# Public browser configuration only. Never put service-role or JWT secrets here.
VITE_BACKEND_URL=http://127.0.0.1:3001
VITE_GAME_SERVER_URL=http://127.0.0.1:3000
VITE_BACKEND_ANON_KEY=copy-the-local-backender-anon-key

# Public Supabase Storage configuration used only for PlaceAd artwork uploads.
# The anon key is safe for browser use; bucket policies still control access.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=copy-your-supabase-anon-key
