HOST=127.0.0.1
PORT=3001
PUBLIC_URL=http://127.0.0.1:3001
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ANON_KEY=replace-with-local-public-key
SERVICE_ROLE_KEY=replace-with-long-private-key
JWT_SECRET=replace-with-at-least-32-random-characters
DATA_FILE=./data/backender.json

# Keep file for local development; postgres opts into Supabase storage.
STORAGE_DRIVER=file
# DATABASE_URL and DATABASE_CA_FILE are server-only, never VITE_* variables.
