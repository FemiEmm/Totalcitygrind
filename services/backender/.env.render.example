# Enter these in Render Environment; never commit real values.
NODE_ENV=production
HOST=0.0.0.0
STORAGE_DRIVER=postgres
CLIENT_ORIGINS=https://totalcitygrind.netlify.app
ANON_KEY=replace-with-public-client-key
SERVICE_ROLE_KEY=replace-with-private-random-key-at-least-32-characters
JWT_SECRET=replace-with-different-private-random-secret-at-least-32-characters
DATABASE_URL=postgresql://USER:PASSWORD@SESSION_POOLER_HOST:5432/postgres
# Optional: Render secret-file path for the Supabase CA certificate.
# DATABASE_CA_FILE=/etc/secrets/supabase-ca.crt
# Render supplies PORT and RENDER_EXTERNAL_URL automatically.
