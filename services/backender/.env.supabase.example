# Supabase PostgreSQL storage; accounts are managed by Backender, not Supabase Auth.
HOST=127.0.0.1
PORT=3001
PUBLIC_URL=http://127.0.0.1:3001
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ANON_KEY=keep-the-existing-backender-public-key
SERVICE_ROLE_KEY=keep-the-existing-private-game-server-key
JWT_SECRET=keep-the-existing-private-jwt-secret
STORAGE_DRIVER=postgres
# Supabase > Connect > Session pooler > URI; substitute the database password locally.
DATABASE_URL=
# Optional path to Supabase's downloaded CA certificate if required by your endpoint.
DATABASE_CA_FILE=
