# Local development only by default. Copy to .env to customize.
HOST=127.0.0.1
PORT=3000
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
MAX_PLAYERS=20
SNAPSHOT_HZ=10
# File-based Electron origins are disabled until the client is connected.
ALLOW_NULL_ORIGIN=false

# Start Backender first. Use the matching keys from its .env.
REQUIRE_AUTH=true
BACKEND_PROVIDER=backender
BACKEND_URL=http://127.0.0.1:3001
BACKEND_ANON_KEY=copy-backender-anon-key
BACKEND_SERVICE_ROLE_KEY=copy-backender-service-role-key
# Supabase migration also needs the game_state RPC/storage implementation; changing keys alone is not sufficient.
# Keep the same browser /api/game contract. Never put service keys in VITE_*.
