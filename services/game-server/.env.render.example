# Enter these in Render Environment; never commit real values.
NODE_ENV=production
HOST=0.0.0.0
REQUIRE_AUTH=true
BACKEND_PROVIDER=backender
BACKEND_URL=https://YOUR-BACKENDER-SERVICE.onrender.com
BACKEND_ANON_KEY=match-backender-ANON_KEY
BACKEND_SERVICE_ROLE_KEY=match-backender-SERVICE_ROLE_KEY
CLIENT_ORIGINS=https://totalcitygrind.netlify.app
ALLOW_NULL_ORIGIN=false
MAX_PLAYERS=100
SNAPSHOT_HZ=10
# Render supplies PORT automatically. Keep one instance for this shared world.
